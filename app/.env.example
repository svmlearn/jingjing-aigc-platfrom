# Public Supabase values. These are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
APIFY_TOKEN=
OPENAI_API_KEY=
ADMIN_SETUP_SECRET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-singapore

# Optional runtime switches.
IMPORT_PROVIDER=apify
DEFAULT_MAX_COMMENTS=30
DEFAULT_CREATOR_POSTS=20
APIFY_WAIT_SECONDS=120
COS_STS_DURATION_SECONDS=1800
COS_READ_URL_TTL_SECONDS=3600
MEDIA_UPLOAD_MAX_BYTES=1073741824
