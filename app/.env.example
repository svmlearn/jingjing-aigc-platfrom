# PostgreSQL / app-owned auth. Current domestic mainline uses this path.
DATABASE_PROVIDER=postgres
APP_DATABASE_URL=
DATABASE_URL=
APP_DATABASE_SSL=
APP_DATABASE_POOL_MAX=8
APP_SESSION_COOKIE=jingjing_session
APP_SESSION_TTL_SECONDS=1209600
# IP-stage domestic validation usually runs over HTTP, so keep this false until HTTPS/domain stage.
APP_SESSION_SECURE_COOKIE=false

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
APIFY_TOKEN=
TIKHUB_API_KEY=
# Optional. Mainland China can use https://api.tikhub.dev; default is https://api.tikhub.io.
TIKHUB_BASE_URL=
TIKHUB_MATERIAL_CACHE_TTL_HOURS=72
# Preferred for OpenAI-compatible providers such as SiliconFlow.
SILICONFLOW_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=
# Required for private merchant media Pexels-compatible search download URLs.
# Server-only secret used to sign /api/private-media/download/<token>.
PRIVATE_MEDIA_DOWNLOAD_TOKEN_SECRET=

# Dify workflow runtime. Server-only; never prefix with NEXT_PUBLIC_.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_WORKFLOW_RESPONSE_MODE=streaming
DIFY_WORKFLOW_TIMEOUT_SECONDS=900
DIFY_WORKFLOW_VERSION=v3.1

# Content generation queue worker. One process, one job at a time.
APP_BASE_URL=http://127.0.0.1:3000
CONTENT_GENERATION_WORKER_SECRET=
CONTENT_GENERATION_WORKER_POLL_MS=10000
CONTENT_GENERATION_WORKER_IDLE_MS=30000
CONTENT_GENERATION_WORKER_REQUEST_TIMEOUT_MS=960000

ADMIN_SETUP_SECRET=

# Current object storage. New app writes should use Aliyun OSS.
STORAGE_PROVIDER=aliyun_oss
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-guangzhou
ALIYUN_OSS_ENDPOINT=
# Optional for a future STS credential flow. Batch 9B browser upload uses signed PUT URLs.
ALIYUN_OSS_STS_ROLE_ARN=
ALIYUN_OSS_STS_DURATION_SECONDS=1800
ALIYUN_OSS_READ_URL_TTL_SECONDS=3600
MEDIA_UPLOAD_MAX_BYTES=1073741824

# Optional runtime switches.
IMPORT_PROVIDER=apify
DEFAULT_MAX_COMMENTS=30
DEFAULT_CREATOR_POSTS=20
APIFY_WAIT_SECONDS=120
EMBEDDING_DIMENSIONS=1536
# Enable only for first-phase domestic IP validation if using the video-chain test button.
VIDEO_CHAIN_TEST_ENTRYPOINT_ENABLED=

# Optional domestic API smoke script inputs. Do not commit real values.
DOMESTIC_APP_BASE_URL=
DOMESTIC_SMOKE_EMAIL=
DOMESTIC_SMOKE_PASSWORD=
DOMESTIC_SMOKE_WITH_UPLOAD_INTENT=

# Temporary local smoke-test bridge only.
# Leave empty for normal local demo mode. If set, local demo uploads/jobs are mirrored
# into the worker Postgres DB so the staging video worker can process them.
LOCAL_REAL_CHAIN_DB_URL=
LOCAL_REAL_CHAIN_DB_SSL=
LOCAL_REAL_CHAIN_MERCHANT_ID=00000000-0000-4000-8000-000000000101
LOCAL_REAL_CHAIN_MERCHANT_NAME=Local Real Chain Smoke Test
