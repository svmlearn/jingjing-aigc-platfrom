# Copy to /etc/jingjing/app.env on the domestic server.
# Fill real values outside Git. Never commit real secrets.

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Database
DATABASE_PROVIDER=postgres
APP_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
APP_DATABASE_SSL=require
APP_DATABASE_POOL_MAX=8

# Session
APP_SESSION_COOKIE=jingjing_session
APP_SESSION_TTL_SECONDS=1209600
# IP-stage validation is usually HTTP. Set true only after HTTPS is active.
APP_SESSION_SECURE_COOKIE=false

# Object storage. Keep tencent_cos until Aliyun OSS SDK wiring is verified.
STORAGE_PROVIDER=tencent_cos

# Tencent COS mainland bucket
COS_SECRET_ID=<secret-id>
COS_SECRET_KEY=<secret-key>
COS_BUCKET=<bucket-name-with-appid>
COS_REGION=ap-guangzhou
COS_STS_DURATION_SECONDS=1800
COS_READ_URL_TTL_SECONDS=3600
MEDIA_UPLOAD_MAX_BYTES=1073741824

# Aliyun OSS target. Do not fill COS_* with Aliyun values.
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-guangzhou
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_STS_ROLE_ARN=
ALIYUN_OSS_STS_DURATION_SECONDS=1800
ALIYUN_OSS_READ_URL_TTL_SECONDS=3600

# First-phase IP validation only. Disable after the test draft entrypoint is no longer needed.
VIDEO_CHAIN_TEST_ENTRYPOINT_ENABLED=1

# Optional import / AI providers. Fill only if the tested flow needs them.
APIFY_TOKEN=
TIKHUB_API_KEY=
TIKHUB_BASE_URL=
SILICONFLOW_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=

# Domestic API smoke script inputs. These are read by scripts, not by the app runtime.
DOMESTIC_APP_BASE_URL=http://<domestic-ip>
DOMESTIC_SMOKE_EMAIL=owner@example.com
DOMESTIC_SMOKE_PASSWORD=<temporary-password>
DOMESTIC_SMOKE_WITH_UPLOAD_INTENT=1

# Keep Supabase empty in domestic phase1 unless explicitly testing fallback compatibility.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
