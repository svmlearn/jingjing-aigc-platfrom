# Copy this file to .env before running docker compose.

# Host directories
VIDEO_WORKER_HOST_ROOT=/srv/jingjing-video-worker

# Database
SUPABASE_DB_URL=postgresql://postgres:postgres@db.example.supabase.co:5432/postgres

# Tencent COS
# Current staging bucket: jj-content-staging-1341668543
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=jj-content-staging-1341668543
COS_REGION=ap-singapore

# Worker runtime
WORKER_POLL_INTERVAL_SECONDS=10
WORKER_MAX_CONCURRENCY=1
VIDEO_JOB_STALE_MINUTES=120
WORKER_TEMP_ROOT=/srv/jingjing-video-worker/tmp
WORKER_MODELS_ROOT=/srv/jingjing-video-worker/models
WORKER_OUTPUT_ROOT=/srv/jingjing-video-worker/outputs
OPENSTORYLINE_BASE_URL=http://openstoryline-engine:8000
OPENSTORYLINE_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO

# OpenStoryline / model providers
OPENSTORYLINE_ENGINE_ADAPTER=skeleton
# Set to http://firered-openstoryline:7860 when OPENSTORYLINE_ENGINE_ADAPTER=fire_red.
FIRERED_OPENSTORYLINE_BASE_URL=
FIRERED_RUN_TIMEOUT_SECONDS=900
FIRERED_PROVIDER_KEY=
DOWNLOAD_FIRERED_ASSETS=false
OPENSTORYLINE_LLM_MODEL=
OPENSTORYLINE_LLM_BASE_URL=
OPENSTORYLINE_LLM_API_KEY=
OPENSTORYLINE_VLM_MODEL=
OPENSTORYLINE_VLM_BASE_URL=
OPENSTORYLINE_VLM_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=
FISH_AUDIO_API_KEY=
