# Copy this file to .env for local skeleton smoke runs.
# Server rendering should use firered.env.example plus docker-compose.firered.yml.

# Host directories
VIDEO_WORKER_HOST_ROOT=/srv/jingjing-video-worker

# Database
# WORKER_DATABASE_URL is preferred for domestic PostgreSQL. SUPABASE_DB_URL remains
# accepted only as a short-term compatibility fallback.
WORKER_DATABASE_URL=postgresql://postgres:postgres@postgres.internal:5432/jingjing
SUPABASE_DB_URL=

# Object storage
WORKER_STORAGE_PROVIDER=aliyun_oss
WORKER_STORAGE_RESULT_PREFIX=video-results

# Tencent COS
# WORKER_COS_* overrides are preferred for the worker; COS_* remains supported.
WORKER_COS_SECRET_ID=
WORKER_COS_SECRET_KEY=
WORKER_COS_BUCKET=
WORKER_COS_REGION=ap-guangzhou
WORKER_COS_RESULT_PREFIX=video-results

# Shared COS fallback. Keep aligned with WORKER_COS_* only if a component still reads COS_*.
# WORKER_COS_* overrides are preferred for the worker; COS_* remains supported.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# Aliyun OSS. Use these for Aliyun domestic validation with WORKER_STORAGE_PROVIDER=aliyun_oss.
WORKER_ALIYUN_OSS_ACCESS_KEY_ID=
WORKER_ALIYUN_OSS_ACCESS_KEY_SECRET=
WORKER_ALIYUN_OSS_BUCKET=
WORKER_ALIYUN_OSS_REGION=oss-cn-hangzhou
WORKER_ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
WORKER_ALIYUN_OSS_RESULT_PREFIX=video-results
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# Worker runtime
WORKER_POLL_INTERVAL_SECONDS=10
WORKER_MAX_CONCURRENCY=1
VIDEO_JOB_STALE_MINUTES=120
WORKER_TEMP_ROOT=/srv/jingjing-video-worker/tmp
WORKER_MODELS_ROOT=/srv/jingjing-video-worker/models
WORKER_OUTPUT_ROOT=/srv/jingjing-video-worker/outputs
OPENSTORYLINE_BASE_URL=http://openstoryline-engine:8000
OPENSTORYLINE_TIMEOUT_SECONDS=2700
LOG_LEVEL=INFO

# OpenStoryline / model providers
OPENSTORYLINE_ENGINE_ADAPTER=skeleton
# Set to http://firered-openstoryline:7860 when OPENSTORYLINE_ENGINE_ADAPTER=fire_red.
FIRERED_OPENSTORYLINE_BASE_URL=
FIRERED_RUN_TIMEOUT_SECONDS=2700
FIRERED_PROVIDER_KEY=
DOWNLOAD_FIRERED_ASSETS=true
OPENSTORYLINE_LLM_MODEL=glm-5.1
OPENSTORYLINE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENSTORYLINE_LLM_API_KEY=
OPENSTORYLINE_VLM_MODEL=glm-5v-turbo
OPENSTORYLINE_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENSTORYLINE_VLM_API_KEY=
# FireRed TTS provider selected by platform productionConfig.
OPENSTORYLINE_TTS_PROVIDER=bytedance_bigtts

# ASR provider. Production FireRed runs use aliyun_paraformer with ALIYUN_ASR_API_KEY
# or DASHSCOPE_API_KEY set. Do not deploy local FunASR models for the OSS production path.
OPENSTORYLINE_ASR_PROVIDER=aliyun_paraformer
ALIYUN_ASR_MODEL=paraformer-realtime-v2
ALIYUN_ASR_API_KEY=
ALIYUN_ASR_WORKSPACE=

TTS_302_BASE_URL=https://api.302.ai
TTS_302_API_KEY=
TTS_MINIMAX_BASE_URL=https://api.minimax.io
TTS_MINIMAX_API_KEY=
TTS_RUNNINGHUB_BASE_URL=https://www.runninghub.cn
TTS_RUNNINGHUB_API_KEY=
RUNNINGHUB_TTS_EDGE_WORKFLOW_ID=1983513964837543938
TTS_PIXELLE_CLONE_BASE_URL=https://www.runninghub.cn
TTS_PIXELLE_CLONE_API_KEY=
RUNNINGHUB_TTS_CLONE_WORKFLOW_ID=1983718528991862786
TTS_BYTEDANCE_BIGTTS_BASE_URL=https://openspeech.bytedance.com
TTS_BYTEDANCE_BIGTTS_UID=openstoryline
TTS_BYTEDANCE_BIGTTS_APPID=
TTS_BYTEDANCE_BIGTTS_ACCESS_KEY=
TTS_BYTEDANCE_BIGTTS_RESOURCE_ID=
TTS_BYTEDANCE_BIGTTS_SPEAKER=
AI_TRANSITION_DASHSCOPE_API_KEY=
AI_TRANSITION_MINIMAX_API_KEY=
PEXELS_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=
FISH_AUDIO_API_KEY=
